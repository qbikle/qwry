{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qwry",
  "version": "0.9.7",
  "identifier": "com.manishgudewar.qwry",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "qwry",
        "width": 1240,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5NDc4NjMyQzI0RjczRTAKUldUZ2MwL0NNb1pIK2VQUVZQYUxjR2JWOVY0enlVVUxrTWNwNDA4TU1vQ3JIS3h1OEpIZ2hpQTcK",
      "endpoints": [
        "https://github.com/qbikle/qwry/releases/latest/download/latest.json"
      ]
    }
  }
}